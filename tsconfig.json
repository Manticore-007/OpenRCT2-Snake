{
	"compilerOptions": {
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"module": "node16",
		"moduleResolution": "node16",
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"outDir": "out",
		"rootDir": ".",
		"strict": true,
		"target": "es6",
		"lib": [ "ES6" ]
	},
	"include": [
		"./lib/**/*.ts",
		"./src/**/*.ts",
	],
	"noEmit": true
}
